# Server only. Never use VITE_ for secrets. Do not commit .env.
GEMINI_API_KEY=your_server_side_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# For production set to your exact frontend origin (no trailing slash).
# APP_ORIGIN=https://your-domain.example
# Set only when deployed behind a known reverse proxy.
# TRUST_PROXY_HOPS=1
# Optional: allow adding/updating a key from Settings, protected by this admin code.
# Use a unique random value of at least 24 characters. Never prefix it with VITE_.
# In development, an ephemeral setup code is printed if this is unset.
# In production, browser setup is disabled unless this is set.
# PIXORA_SETUP_TOKEN=replace_with_a_long_random_server_admin_code

# Optional account backend. These are PUBLIC browser configuration values only.
# Never put a Supabase service-role key or encryption secret in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set by the GitHub Pages workflow, not needed for normal local development.
# VITE_APP_BASE=/ai-image-editor-/
# VITE_GITHUB_PAGES=true
